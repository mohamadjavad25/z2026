# The server's scheduled jobs; install as /etc/cron.d/frfro (root). Server clock is Asia/Tehran.
# These replace the frfro user's old crontab, which ran from the retired /srv/frfro/app checkout.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/5  * * * * root /opt/frfro/bin/cron-call.sh expire-bookings >> /var/log/frfro-cron.log 2>&1
*/10 * * * * root /opt/frfro/bin/cron-call.sh send-reminders  >> /var/log/frfro-cron.log 2>&1
17   * * * * root /opt/frfro/bin/cron-call.sh billing         >> /var/log/frfro-cron.log 2>&1
30   3 * * * root /opt/frfro/bin/backup-db.sh                 >> /var/log/frfro-cron.log 2>&1
