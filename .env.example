# Public production domain (no trailing slash). Single source of truth for:
#   - app/layout.jsx        -> metadataBase (root metadata export)
#   - app/sitemap.js        -> every <loc> in sitemap.xml
#   - app/robots.js         -> the Sitemap: line in robots.txt
#   - app/salons/[id], app/artists/[id], app/shops/[id] -> alternates.canonical
#
# If unset, all of the above fall back to the placeholder
# "https://zibaban.example.com" so local dev / CI never breaks — but this
# MUST be set to the real zibaban domain in production, otherwise every URL
# submitted to Google (and every canonical/OG tag) will point at a fake host.
NEXT_PUBLIC_SITE_URL=https://zibaban.example.com

# Required in production for wallet withdrawal admin actions (app/api/wallet/route.js).
# Without this set, that endpoint fails closed (503) rather than allowing an
# unauthenticated admin action through — so this is a "feature silently
# unavailable until set" risk, not a security hole, but it must be set before
# launch or wallet withdrawal confirmations will not work at all.
# Generate a long random string and keep it secret (do not commit the real value).
ZIBABAN_WALLET_ADMIN_TOKEN=

# --- Optional tuning knobs (safe defaults if unset; documented here so a
# future deploy doesn't have to go spelunking in app/lib/bookingExpirySweep.js
# to discover they exist) ---

# Path to the SQLite database file. Defaults to data/zibaban.sqlite relative
# to the project root. Only override this if your hosting environment needs
# the DB on a specific persistent-disk mount path.
# ZIBABAN_DB_PATH=

# Minutes before an unanswered booking request / unacknowledged shop order
# auto-expires. Defaults to 60 (the founder-approved "Snapp-Food-style" 1-hour
# window). Do not lower this in production without a product decision — it's
# a real, client-facing SLA, not just an internal timeout.
# ZIBABAN_BOOKING_REQUEST_TIMEOUT_MINUTES=60

# How often the expiry sweep checks for timed-out bookings/orders, in
# milliseconds. Defaults to 3 minutes. Lowering this increases DB query
# frequency for marginally tighter timing precision.
# ZIBABAN_BOOKING_EXPIRY_SWEEP_MS=180000
