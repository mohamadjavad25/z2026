# Public production domain (no trailing slash). Single source of truth for:
#   - app/layout.jsx        -> metadataBase (root metadata export)
#   - app/sitemap.js        -> every <loc> in sitemap.xml
#   - app/robots.js         -> the Sitemap: line in robots.txt
#   - app/salons/[id], app/artists/[id] -> alternates.canonical
#
# If unset, all of the above fall back to the placeholder
# "https://zibaban.example.com" so local dev / CI never breaks — but this
# MUST be set to the real zibaban domain in production, otherwise every URL
# submitted to Google (and every canonical/OG tag) will point at a fake host.
NEXT_PUBLIC_SITE_URL=https://zibaban.example.com

# --- Database (Postgres — required) ---
#
# This app persists everything in Postgres via the `pg` package
# (app/lib/db/connection.js). REQUIRED in every environment, including local
# dev — there is no SQLite/file-based fallback any more (Vercel's serverless
# functions have an ephemeral filesystem, so a local file can't survive
# across requests there).
#
# On Vercel: add the Vercel Postgres (Neon-backed) integration to your
# project — it auto-populates POSTGRES_URL and POSTGRES_URL_NON_POOLING for
# every environment (Production/Preview/Development) for you; you don't need
# to set these by hand there.
#
# Locally / self-hosted: point POSTGRES_URL at any reachable Postgres 14+
# instance, e.g.:
#   POSTGRES_URL=postgresql://user:password@localhost:5432/zibaban
# Schema is managed by versioned migrations (migrations/, run via
# `npm run migrate`) — run that once against a fresh database before
# starting the app. See app/lib/README.md for details.
POSTGRES_URL=
# Optional: a non-pooled/direct connection string. The app itself falls back
# to POSTGRES_URL for everything, including transactions, if this is unset.
# `npm run migrate` prefers this one when set — some DDL needs session-level
# locks a transaction-mode pooler (Supabase's Supavisor) doesn't support.
# POSTGRES_URL_NON_POOLING=
# Optional, used ONLY by `npm run migrate` and checked before the names
# above. On Vercel + Supabase set this to the *Session pooler* string
# (host aws-0-<region>.pooler.supabase.com, port 5432): the integration's
# POSTGRES_URL_NON_POOLING is the IPv6-only direct host, which Vercel's
# IPv4 build machines can't reach.
# MIGRATE_DATABASE_URL=

# Optional generic fallback name, checked last, for any other Postgres host
# that doesn't set the two Vercel-flavored names above.
# DATABASE_URL=

# Optional TLS hardening: path to a CA certificate file to verify the
# Postgres server's certificate against (rejectUnauthorized: true) instead
# of accepting any certificate. For Supabase: dashboard -> Project Settings
# -> Database -> SSL Configuration, download the CA certificate, and point
# this at the downloaded file. Without this set, the app accepts any
# certificate the server presents (see app/lib/db/connection.js's
# resolveSslConfig() for why that's the current default, not just an
# oversight) -- setting PGSSL_CA_PATH is the recommended hardening step
# once you've obtained and verified your provider's actual CA certificate.
# The Supabase root CA (public, not a secret) is committed at
# certs/supabase-ca.crt, so on Vercel you can set:
#   PGSSL_CA_PATH=certs/supabase-ca.crt
# PGSSL_CA (the PEM text itself) is also accepted and wins over the path.
# PGSSL_CA_PATH=
# PGSSL_CA=

# Optional: max size of the app's Postgres connection pool (app/lib/db/connection.js).
# Defaults to 10. Raise or lower this based on your actual Supavisor/Postgres
# connection budget divided by how many concurrent app instances you run.
# PGPOOL_MAX=10

# --- Optional tuning knobs (safe defaults if unset; documented here so a
# future deploy doesn't have to go spelunking in app/lib/bookingExpirySweep.js
# to discover they exist) ---

# Minutes before an unanswered booking request auto-expires. Defaults to 60
# (the founder-approved "Snapp-Food-style" 1-hour window). Do not lower this
# in production without a product decision — it's
# a real, client-facing SLA, not just an internal timeout.
# ZIBABAN_BOOKING_REQUEST_TIMEOUT_MINUTES=60

# Shared secret app/api/cron/expire-bookings requires as
# `Authorization: Bearer <CRON_SECRET>` -- set this to a long random value
# and configure your scheduler (Supabase pg_cron via net.http_post, or any
# external scheduler) to call that endpoint on that same schedule, sending
# this header. Recommended interval: 3 minutes (see
# RECOMMENDED_SWEEP_INTERVAL_MS in app/lib/bookingExpirySweep.js) --
# tighter doesn't meaningfully improve expiry timing precision, looser
# means a slower "your request expired" notice. Unset means the endpoint
# always rejects with 401 (fails closed, not open).
#
# .github/workflows/cron-expire-bookings.yml already calls this endpoint on
# a schedule -- once this app is actually deployed, set this same value
# (plus APP_URL, e.g. https://zibaban.example.com) as GitHub repo secrets
# under Settings -> Secrets and variables -> Actions. Until both secrets
# are set, that workflow no-ops on every scheduled run instead of failing.
# CRON_SECRET=

# Web Push (real browser notifications — see app/lib/push.js). Required in
# production or push silently no-ops (subscribe requests still succeed and
# store a subscription, but sends fail closed and are swallowed — a
# "feature unavailable until set" risk, not a security hole). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is also read by the browser (NEXT_PUBLIC_ prefix — it is
# NOT secret, it's how the browser verifies push messages actually came from
# this server's private key). Never commit real values here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
ZIBABAN_VAPID_PRIVATE_KEY=
# Contact URL/email required by the Web Push protocol (RFC 8292) so a push
# service can reach the sender if something's wrong — any mailto: or https:
# URL is valid, it doesn't need to be monitored.
ZIBABAN_VAPID_CONTACT=mailto:support@zibaban.example.com

# Shared secret for the manual account-recovery queue (POST /api/auth/password-reset-requests,
# GET .../password-reset-requests, POST .../password-reset-requests/[id]/resolve). Anyone who
# knows this token can list phone numbers of locked-out users and set a new password for any
# account, so treat it like an admin password: generate a long random value and never commit
# the real one. Unset (the default) means the admin GET/resolve routes always reject with 401 —
# the create route still works so users can file a request even before this is configured.
ZIBABAN_ADMIN_TOKEN=

# Admin panel (/admin): comma-separated phone numbers of the accounts that may use it, e.g.
# ZIBABAN_ADMIN_PHONES=09121234567,09351234567. Empty = nobody. Being listed is not enough: admins sign in at /admin
# with phone + account password + a 6-digit code from an authenticator app (Google Authenticator etc.).
ZIBABAN_ADMIN_PHONES=
# REQUIRED for the admin login: 32+ random characters. Encrypts the stored authenticator secrets. Unset/short = admin login disabled.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZIBABAN_ADMIN_SECRET=
# One-time key (16+ chars) that must be typed on /admin -> "first-time setup" to link an authenticator app. Knowing a password alone can never enroll.
# Unset = nobody can set up a new authenticator. Keep it secret; you can change it after everyone is enrolled.
ZIBABAN_ADMIN_SETUP_KEY=

# Supabase Storage (app/lib/storage.js) -- dual-write path for avatar/
# poster/post images alongside the existing base64 columns (see
# migrations/008_media_storage_urls.sql and docs/DEVLOG.md for the full
# staged-migration plan). Unset means every upload silently stays
# base64-only, exactly like before these columns/this module existed --
# nothing breaks, it just doesn't get a Storage copy yet.
#
# SUPABASE_URL: your project's URL (Project Settings -> API -> Project URL).
# SUPABASE_SERVICE_ROLE_KEY: the SERVICE ROLE key, not the anon key --
#   uploads happen server-side with no per-user Supabase auth, so this
#   needs to bypass Row Level Security. Never expose this to the browser
#   (no NEXT_PUBLIC_ prefix, and it never should get one).
# SUPABASE_STORAGE_BUCKET: defaults to "media" if unset. Create this
#   bucket in the Supabase dashboard (Storage -> New bucket) and mark it
#   public, or set up a policy allowing public read -- avatar/poster/post
#   images are meant to be publicly viewable, same as today's
#   /api/media/* streaming routes.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media

# SMS verification (app/lib/sms.js). ZIBABAN_SMS_PROVIDER = farazsms | kavenegar | test; unset = SMS off.
# Faraz SMS (sms.farazsms.com): panel -> Developers -> API key; create an approved "pattern" (e.g.
# "کد تأیید فرفرو: %code%") and use its code; sender is your line number (e.g. +983000505).
# ZIBABAN_SMS_PROVIDER=farazsms
# FARAZSMS_API_KEY=
# FARAZSMS_PATTERN_CODE=
# FARAZSMS_SENDER=
# FARAZSMS_PARAM=code
